<!DOCTYPE html>
<html lang="en">
  <head>
    <link rel="stylesheet" href="style.css" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Members</title>
  </head>
  <body>
    <div class="navbar">
      <a href="/">Home</a>
      <% if (user) { %>
      <a href="/premium">Premium</a>
      <a href="/logout">Logout</a>
      <% } else { %>
      <a href="/signup">Sign-up</a>
      <a href="/login">Login</a>
      <% } %>
    </div>
    <% if (user) { %>
    <a href="/message" class="newMessage">
      <button>New Message</button>
    </a>
    <% } %>
    <div class="messagesContainer">
      <% messages.forEach((message) => { %>
      <div class="messageCard">
        <h2><%= message.title %></h2>
        <p class="content"><%= message.content %></p>
        <div class="msgFooter">
          <p>
            <strong>at </strong> <% if (!user || user.membership_status ===
            "guest") { %> --- <% } else { %> <%= message.formatted_date %> <% }
            %>
          </p>
          <p>
            <strong>by </strong>
            <% if (!user || user.membership_status === "guest") { %> --- <% }
            else { %> <%= message.username %> <% } %>
          </p>
        </div>
        <% if (user && user.membership_status === "admin") { %>
        <a href="/delete/<%= message.id %>" class="delMessage">
          <button>Delete</button>
        </a>
        <% } %>
      </div>
      <% }) %>
    </div>
  </body>
</html>
